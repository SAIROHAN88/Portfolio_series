# Public origin of the deployed site.
#
# Used for absolute social-card URLs (og:image, twitter:image, canonical),
# which social platforms require — a relative path renders no preview.
#
# This file holds PUBLIC build configuration only. Never put secrets here:
# anything in VITE_* is inlined into the client bundle.
#
# Change VITE_SITE_URL when the site moves to a custom domain.
VITE_SITE_URL=https://sai-rohan88.github.io/Portfolio_series

# Path prefix for the built site. GitHub Pages serves project sites from a
# sub-path ("/<repo>/"); set this to "/" for a root domain such as Vercel,
# Netlify or a custom domain.
VITE_BASE_PATH=/Portfolio_series/
